<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Push-to-talk conversation. Recognition runs on-device (API 31+
         on-device recognizer); audio never leaves the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- One-time model downloads only (GenieX SLM, Kokoro voice) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The guidance pipeline runs as a camera foreground service so it
         survives the screen turning off / phone in a pocket -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Walking navigation (GPS compass guidance + geocoded destinations) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Cane board link: BLE to the UNO Q (Modulino distance in, motor
         letters out) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- ARCore supplies the areamap's pose and depth. Declared OPTIONAL,
         not required: the app must still install and navigate by compass
         on a device without it, and PdrPose covers tracking loss. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shepherd">

        <!-- Vendor native libraries the QNN backends dlopen. Without these
             declarations the Android linker blocks them (API 31+ namespace
             rules): libcdsprpc = FastRPC to the Hexagon DSP/NPU (HTP),
             libOpenCL = Adreno GPU backend. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <!-- Route mini-map (Maps SDK for Android, lite mode) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- "optional" keeps the APK installable everywhere and lets the
             app decide at runtime whether ARCore is usable. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <service
            android:name=".service.ShepherdService"
            android:exported="false"
            android:foregroundServiceType="camera|location" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
