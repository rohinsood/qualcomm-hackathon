<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Push-to-talk conversation. Recognition runs on-device (API 31+
         on-device recognizer); audio never leaves the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- One-time model downloads only (GenieX SLM, Kokoro voice) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The guidance pipeline runs as a camera foreground service so it
         survives the screen turning off / phone in a pocket -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Walking navigation (Google Routes API + GPS route following) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shepherd">

        <!-- Vendor native libraries the QNN backends dlopen. Without these
             declarations the Android linker blocks them (API 31+ namespace
             rules): libcdsprpc = FastRPC to the Hexagon DSP/NPU (HTP),
             libOpenCL = Adreno GPU backend. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <service
            android:name=".service.ShepherdService"
            android:exported="false"
            android:foregroundServiceType="camera|location" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
