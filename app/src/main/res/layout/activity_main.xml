<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- INVISIBLE, not GONE: CameraX needs the preview surface to exist
         or the whole capture session (analysis included) never starts -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:scaleType="fitCenter" />

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:importantForAccessibility="no" />

    <dev.quad.shepherd.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#88000000"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/navModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/nav_mode_toggle"
            android:textColor="@android:color/white" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/audioToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/audio_toggle"
            android:textColor="@android:color/white" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/depthToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/depth_toggle"
            android:textColor="@android:color/white" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/debugToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/debug_toggle"
            android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:text="@string/loading_model" />
    </LinearLayout>

    <TextView
        android:id="@+id/debugText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="64dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:textColor="#B2FF59"
        android:textSize="10sp"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <dev.quad.shepherd.ui.SteerView
        android:id="@+id/steerView"
        android:layout_width="190dp"
        android:layout_height="170dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="120dp"
        android:importantForAccessibility="no" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/talkButton"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:layout_marginBottom="32dp"
        android:text="@string/talk_button"
        android:textSize="18sp"
        android:contentDescription="@string/talk_button_a11y" />
</FrameLayout>
